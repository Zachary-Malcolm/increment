# Copy to .env.local and fill in from Supabase: Project Settings > API.
# Without these the app still works, saving progress in the browser only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set to true once Google sign-in is enabled in Supabase (Authentication > Providers).
VITE_ENABLE_GOOGLE=false
